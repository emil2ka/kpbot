# xAI — create a new key in the xAI console; never commit a real key.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Supabase → Project Settings → API. Use the server-side service_role key only
# in this backend, never in a browser or frontend application.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects the API endpoints when deployed.
APP_API_KEY=

# Product selection defaults
MIN_KASPI_PRICE_KZT=4000
MIN_REVIEWS=15
MAX_SELLERS=8

